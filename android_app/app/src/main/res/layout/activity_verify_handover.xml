<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_ultra_light"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm handover"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Meet the student on campus. Scan their QR code, or type the PIN they show you. Your credits are released when the code is correct."
        android:textColor="@color/grey_dark"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/black"
        android:text="SCAN QR CODE"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Or enter the 6 digit PIN"
        android:textColor="@color/grey_dark"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        android:hint="PIN"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/black" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyPin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/charcoal_dark"
        android:text="VERIFY PIN"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
